entity BCD_Decoder is
	port(
		A0,A1,A2,A3,CS1,CS2: in bit;
		OUT0, OUT1, OUT2, OUT3, OUT4, OUT5, OUT6, OUT7, OUT8, OUT9: out bit); 
end entity BCD_Decoder;

architecture LogicOperation of BCD_Decoder is
	begin
		OUT0<=NOT(NOT A3 AND NOT A2 AND NOT A1 AND NOT A0);
		OUT1<=NOT(NOT A3 AND NOT A2 AND NOT A1 AND A0);
		OUT2<=NOT(NOT A3 AND NOT A2 AND A1 AND NOT A0);
		OUT3<=NOT(NOT A3 AND NOT A2 AND A1 AND A0);
		OUT4<=NOT(NOT A3 AND A2 AND NOT A1 AND NOT A0);
		OUT5<=NOT(NOT A3 AND A2 AND NOT A1 AND A0);
		OUT6<=NOT(NOT A3 AND A2 AND A1 AND NOT A0);
		OUT7<=NOT(NOT A3 AND A2 AND A1 AND A0);
		OUT8<=NOT(A3 AND NOT A2 AND NOT A1 AND NOT A0);
		OUT9<=NOT(A3 AND NOT A2 AND NOT A1 AND A0);
end architecture LogicOperation;